load("@rules_apple//apple:apple.bzl", "apple_static_xcframework")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//rule:jni_library.bzl", "cc_jni_library")

cc_library(
    name = "ios",
    srcs = glob([
        "*.c",
        "*.h",
    ]),
    target_compatible_with = ["@platforms//os:ios"],
    visibility = ["//touchcontroller:__subpackages__"],
    deps = [
        "//touchcontroller/proxy/server/util/ringbuffer",
        "@rules_jni//jni",
    ],
)

# A standalone dylib variant of the transport, bundled inside the mod JAR so launchers
# that don't statically link the XCFramework can still load it from the game side.
# This target can only be built on a macOS host with Xcode installed.
cc_jni_library(
    name = "proxy_server_ios",
    platforms = [
        "@//platforms:ios_arm64",
    ],
    shared_lib_name = "libproxy_server_ios.dylib",
    visibility = ["//touchcontroller:__subpackages__"],
    deps = [":ios"],
)

apple_static_xcframework(
    name = "ios_framework",
    bundle_id = "top.fifthlight.touchcontroller.proxy.ios",
    bundle_name = "touchcontroller_proxy",
    features = ["exported_symbols"],
    infoplists = ["Info.plist"],
    ios = {
        "simulator": [
            "arm64",
            "x86_64",
        ],
        "device": [
            "arm64",
        ],
    },
    minimum_os_versions = {
        "ios": "14.0",
    },
    public_hdrs = ["ios.h"],
    tags = [
        "manual",
        "no-ide",
    ],
    deps = [":ios"],
)
